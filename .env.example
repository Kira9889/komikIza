# ============================================================
# FRONTEND (prototype)
# ============================================================
# URL API backend. Saat mode dev, cukup biarkan kosong karena
# Vite otomatis mem-proxy /api ke http://localhost:5001.
# Untuk production di Cloudflare Pages, isi dengan URL backend publik:
# VITE_API_URL="https://api.tenshi.my.id/api"
# VITE_API_URL=""

# ============================================================
# BACKEND (prototype/server)
# ============================================================
# Salin server/.env.example menjadi server/.env lalu isi DATABASE_URL
# dengan connection string dari Neon Dashboard > Connection Details.
# Contoh:
# DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"
# JWT_SECRET="ganti-dengan-string-acak-panjang"
# PORT=5001