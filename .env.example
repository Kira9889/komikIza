# ============================================================
# NEXT.JS FRONTEND
# ============================================================
# Browser memakai /api saat lokal (Next rewrite ke Express), dan domain API
# publik saat production. API_SERVER_URL dipakai untuk fetch SSR di server.
NEXT_PUBLIC_API_URL=""
API_SERVER_URL=""
NEXT_PUBLIC_MAINTENANCE="false"

# ============================================================
# BACKEND (prototype/server)
# ============================================================
# Untuk dev lokal bisa ganti kedua URL di atas menjadi http://127.0.0.1:5001/api.
# Salin server/.env.example menjadi server/.env lalu isi DATABASE_URL
# dengan connection string dari Neon Dashboard > Connection Details.
# Contoh:
# DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"
# JWT_SECRET="ganti-dengan-string-acak-panjang"
# PORT=5001
