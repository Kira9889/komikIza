# HTML jangan pernah di-cache (isinya nunjuk nama file JS baru tiap deploy).
# Kalau HTML basi, browser minta bundle lama yang sudah tidak ada -> blank.
/index.html
  Cache-Control: no-store, must-revalidate
/
  Cache-Control: no-store, must-revalidate

# Aset ber-hash abadi: cache setahun penuh, aman.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
