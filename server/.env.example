# Salin file ini menjadi server/.env lalu isi DATABASE_URL milikmu.
# Ambil dari Neon Dashboard > Connection Details.
# Contoh:
# postgresql://user:password@host.neon.tech/neondb?sslmode=require

DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Kunci rahasia untuk JWT (ganti dengan string acak panjang di production)
JWT_SECRET="ganti-dengan-string-acak-panjang"

# Port server (default 5001; di Render biarkan kosong agar pakai PORT bawaan)
PORT=5001

# Daftar origin frontend yang boleh memanggil API (koma, tanpa spasi).
# Default: https://tenshi.my.id,https://www.tenshi.my.id,https://komikiza.pages.dev
# FRONTEND_URL="https://tenshi.my.id,https://www.tenshi.my.id"

# Batas koneksi pool Postgres (default 5). Supabase free Session Pooler
# cuma 15 total untuk backend + sync + dashboard — jangan dibesarkan.
# PG_POOL_MAX=5

# ============================================================
# LOGIN GOOGLE (OAuth) — wajib untuk tombol "Login with Google"
# Buat di Google Cloud Console > APIs & Services > Credentials >
# Create Credentials > OAuth client ID (Web application).
# Authorized redirect URI: https://tenshi.my.id/auth/google/callback
# ============================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://tenshi.my.id/auth/google/callback"

# ============================================================
# PENGIRIM EMAIL (kode verifikasi 6 digit)
# Pakai Gmail App Password: akun Gmail > Kelola Akun > Keamanan >
# Verifikasi 2 langkah ON > Sandi aplikasi > buat "Tenshi.id" (16 huruf).
# ============================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="akunmu@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="akunmu@gmail.com"
